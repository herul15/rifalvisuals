# PT Rifalvisuals Indonesia - Environment Configuration

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=

# Session Security: required HMAC signing key, random and at least 32 bytes.
# See README for generation; never reuse the retired source-code default.
JWT_SECRET=

# Legacy public variable; website CTAs use the WhatsApp number in SiteSetting.
NEXT_PUBLIC_WHATSAPP_NUMBER=
